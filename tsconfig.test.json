{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client", "@playwright/test", "vitest/globals", "@testing-library/jest-dom"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force"
  },
  "include": ["playwright.config.ts", "vitest.config.ts", "tests/**/*.ts", "tests/**/*.tsx"]
}
