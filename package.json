{
  "name": "spp-ui-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test tests/e2e --project=chromium --project=firefox --project=webkit",
    "test:e2e:container": "node ./scripts/run-playwright-container.mjs e2e",
    "test:visual": "node ./scripts/run-playwright-container.mjs visual",
    "test:visual:update": "node ./scripts/run-playwright-container.mjs visual-update",
    "validate:structure": "node ./scripts/validate-project-structure.mjs",
    "verify": "pnpm validate:structure && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm build:storybook"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@material-design-icons/font": "0.14.15",
    "@material/material-color-utilities": "0.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "storybook": "10.5.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
